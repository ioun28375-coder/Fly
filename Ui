-- [[ Simple Admin Menu UI ]] --
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

player.CharacterAdded:Connect(function(newChar)
	character = newChar
	humanoid = character:WaitForChild("Humanoid")
	rootPart = character:WaitForChild("HumanoidRootPart")
end)

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CheatMenuGUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 220, 0, 320)
mainFrame.Position = UDim2.new(0.05, 0, 0.2, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
mainFrame.BorderSizePixel = 0
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 10)
uiCorner.Parent = mainFrame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
title.Text = "⚡ Control Panel"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 18
title.Font = Enum.Font.SourceSansBold
title.Parent = mainFrame

local headerCorner = Instance.new("UICorner")
headerCorner.CornerRadius = UDim.new(0, 10)
headerCorner.Parent = title

local function createButton(name, positionY, color)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.85, 0, 0, 35)
	btn.Position = UDim2.new(0.075, 0, 0, positionY)
	btn.BackgroundColor3 = color or Color3.fromRGB(55, 55, 70)
	btn.Text = name
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 14
	btn.Font = Enum.Font.SourceSansSemibold
	btn.Parent = mainFrame
	
	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = btn
	
	return btn
end

-- 1. Speed & Jump
local isSuperStats = false
local btnSpeed = createButton("🏃 Speed & Jump: OFF", 50)

btnSpeed.MouseButton1Click:Connect(function()
	isSuperStats = not isSuperStats
	if isSuperStats then
		humanoid.WalkSpeed = 100
		humanoid.JumpPower = 120
		btnSpeed.Text = "🏃 Speed & Jump: ON"
		btnSpeed.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
	else
		humanoid.WalkSpeed = 16
		humanoid.JumpPower = 50
		btnSpeed.Text = "🏃 Speed & Jump: OFF"
		btnSpeed.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
	end
end)

-- 2. Flying
local isFlying = false
local bodyVelocity
local btnFly = createButton("🕊️ Fly Mode: OFF", 95)

btnFly.MouseButton1Click:Connect(function()
	isFlying = not isFlying
	if isFlying then
		btnFly.Text = "🕊️ Fly Mode: ON"
		btnFly.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
		
		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		bodyVelocity.Velocity = Vector3.new(0, 0, 0)
		bodyVelocity.Parent = rootPart
		
		task.spawn(function()
			while isFlying do
				RunService.RenderStepped:Wait()
				local camera = workspace.CurrentCamera
				bodyVelocity.Velocity = camera.CFrame.LookVector * 50
			end
		end)
	else
		btnFly.Text = "🕊️ Fly Mode: OFF"
		btnFly.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
		if bodyVelocity then
			bodyVelocity:Destroy()
		end
	end
end)

-- 3. Invisibility
local isInvis = false
local btnInvis = createButton("👻 Invisible: OFF", 140)

btnInvis.MouseButton1Click:Connect(function()
	isInvis = not isInvis
	local targetTransparency = isInvis and 1 or 0
	
	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.Transparency = targetTransparency
		elseif part:IsA("Decal") then
			part.Transparency = targetTransparency
		end
	end
	
	if isInvis then
		btnInvis.Text = "👻 Invisible: ON"
		btnInvis.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
	else
		btnInvis.Text = "👻 Invisible: OFF"
		btnInvis.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
	end
end)

-- 4. Fling Aura
local isFlinging = false
local btnFling = createButton("💥 Fling Aura: OFF", 185)

btnFling.MouseButton1Click:Connect(function()
	isFlinging = not isFlinging
	if isFlinging then
		btnFling.Text = "💥 Fling Aura: ON"
		btnFling.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
		
		task.spawn(function()
			while isFlinging do
				RunService.Heartbeat:Wait()
				rootPart.RotVelocity = Vector3.new(0, 9999, 0)
			end
		end)
	else
		btnFling.Text = "💥 Fling Aura: OFF"
		btnFling.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
		rootPart.RotVelocity = Vector3.new(0, 0, 0)
	end
end)

-- 5. Reset Character
local btnReset = createButton("🔄 Reset Character", 240, Color3.fromRGB(192, 57, 43))
btnReset.MouseButton1Click:Connect(function()
	humanoid.Health = 0
end)
